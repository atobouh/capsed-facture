{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAPSED Bureau",
  "version": "1.0.0",
  "identifier": "cm.capsed.bureau",
  "build": {
    "frontendDist": "../dist-office",
    "beforeBuildCommand": "npm run build:office"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CAPSED Bureau",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#F6F5F7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CAPSED SUARL",
    "shortDescription": "Facturation et encaissement",
    "copyright": "CAPSED SUARL",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
