{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "capsed",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  // The Direction site (built into dist-site); the API and the recovery link run in the Worker first.
  "assets": {
    "directory": "../dist-site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/secours/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "capsed",
      // Replaced by the real id from `wrangler d1 create capsed` at the first deployment.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
